 "B7": {
  "question": "What should the server do if the redirect URI in the authorization request doesn't match the registered one?",
  "answer1": "The server should not proceed with the authorization request if the redirect URI in the authorization request does not match the registered one. The authorization server MUST validate the provided redirect URI against the registered value (Section 10.6).",
  "answer2": "The server should compare the received redirection URI against the registered ones (or their components) and ensure they match. If there is a mismatch, the server MUST NOT automatically redirect to the invalid URI and SHOULD inform the resource owner of the error instead. (Section 3.1.2.3)",
  "sections1": [
   "10.6",
   "3.1.2.3",
   "4.2.1"
  ],
  "sections2": [
   "3.1.2.3",
   "10.6",
